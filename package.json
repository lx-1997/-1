{
  "name": "daocaijing-client",
  "version": "1.0.0",
  "description": "Daocaijing 金融终端：AI 投研、实时行情与风险分析",
  "author": "Daocaijing Team",
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "desktop-dev": "node scripts/start-desktop.js",
    "doctor": "node scripts/doctor.js",
    "backend": "cd backend && .venv/bin/uvicorn deepfocus_api.main:app --host 0.0.0.0 --port 8300 --reload",
    "backend:long": "cd backend && DEEPFOCUS_TRADINGAGENTS_TIMEOUT_SECONDS=3600 .venv/bin/uvicorn deepfocus_api.main:app --host 0.0.0.0 --port 8300",
    "postinstall": "npm run research-workbench:install",
    "research-workbench:install": "npm --prefix modules/research-workbench ci",
    "research-workbench": "npm --prefix modules/research-workbench run tool",
    "tradingagents:install": "bash scripts/install-tradingagents-runtime.sh",
    "build": "react-scripts build",
    "build:desktop": "node scripts/build-target.js desktop",
    "build:android": "node scripts/build-target.js android",
    "android:debug": "npm run build:android && node scripts/android-build.js assembleDebug",
    "android:release": "npm run build:android && node scripts/android-build.js assembleRelease",
    "android:aab": "npm run build:android && node scripts/android-build.js bundleRelease",
    "test": "react-scripts test",
    "test:ci": "CI=true react-scripts test --watchAll=false",
    "lint": "npx tsc --noEmit",
    "test:e2e": "playwright test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "ELECTRON_IS_DEV=1 electron .",
    "desktop:pack": "npm run research-workbench:install && npm run build:desktop && electron-builder",
    "desktop:pack:mac": "npm run research-workbench:install && npm run build:desktop && electron-builder --mac --universal",
    "desktop:pack:win": "npm run research-workbench:install && npm run build:desktop && electron-builder --win --x64",
    "electron-pack": "npm run desktop:pack",
    "check:api": "python3 scripts/check-api-contract.py"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/share": "^7.0.4",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^16.18.68",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@types/react-window": "^1.8.8",
    "antd": "^5.12.8",
    "axios": "^1.6.2",
    "dayjs": "^1.11.18",
    "i18next": "^22.5.1",
    "i18next-browser-languagedetector": "^7.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.20.1",
    "react-scripts": "5.0.1",
    "react-window": "^2.2.7",
    "recharts": "^2.8.0",
    "socket.io-client": "^4.7.4",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^27.5.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "ws": "^8.21.0",
    "form-data": "^4.0.6",
    "underscore": "^1.13.8",
    "shell-quote": "^1.8.4",
    "serialize-javascript": "^7.0.6"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.daocaijing.app",
    "productName": "Daocaijing",
    "artifactName": "daocaijing-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "extraMetadata": {
      "name": "daocaijing-client",
      "productName": "Daocaijing",
      "dependencies": {}
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "public/electron.js",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo512.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/logo512.png",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/logo512.png",
      "category": "Finance"
    }
  },
  "engines": {
    "node": ">=22.3.0"
  }
}
