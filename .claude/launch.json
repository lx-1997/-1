{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "BROWSER=none HOST=127.0.0.1 PORT=3000 REACT_APP_API_BASE_URL=http://127.0.0.1:8300 npm start"],
      "port": 3000
    },
    {
      "name": "terminal-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-s", "build", "-l", "3000"],
      "port": 3000
    }
  ]
}
