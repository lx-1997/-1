# Local development can use mock mode without a cloud key.
# Set to openai, minimax, or openai-compatible when connecting a real model.
DEEPFOCUS_LLM_PROVIDER=mock

# --- 认证 / RBAC / 存储（"摘掉演示态"）---------------------------------------
# 生产环境务必置 true：免费层端点（行情 / 快讯 / 研报列表 / 打点 / 登录注册 / 健康检查 / 公开分享页）
# 仍匿名可达，其余 /api 路由（AI 解读 / 查看研报原文 / 自选股 / 账号 / 管理）都要求合法 Bearer JWT。
# 仅本地开发可置 false（演示态：JWT/RBAC 通道就绪但全旁路）。
DEEPFOCUS_AUTH_REQUIRED=false
# JWT 签名密钥（HS256）。生产**必须**设为高熵随机串（生成：openssl rand -hex 32）。
# AUTH_REQUIRED=true 却留空 → 启动时硬校验直接报错（防止回落到源码内置开发密钥、JWT 被伪造）。
DEEPFOCUS_JWT_SECRET=
# 访问令牌有效期（分钟），默认 720（12 小时）。
DEEPFOCUS_JWT_TTL_MINUTES=720
# 是否允许已有用户后继续自助注册；机构部署可设 false，只让管理员开账号。
DEEPFOCUS_ALLOW_SELF_REGISTER=true
# 首启预置管理员（可选）：两者都设置时，启动自动创建一个 admin 账号。
DEEPFOCUS_ADMIN_EMAIL=
DEEPFOCUS_ADMIN_PASSWORD=
DEEPFOCUS_ADMIN_USERNAME=admin
# 统一存储 URL：默认本地 SQLite；指向 postgresql+psycopg://user:pass@host/db 即整体切托管库。
DEEPFOCUS_DATABASE_URL=

# --- 信号召回投递 + 闭环度量（粘性回流）------------------------------------
# 邮件通道（SMTP）。配齐后召回邮件真实投递；缺 HOST 时优雅降级为 skipped、绝不出网。
DEEPFOCUS_SMTP_HOST=
DEEPFOCUS_SMTP_PORT=587
DEEPFOCUS_SMTP_USER=
DEEPFOCUS_SMTP_PASSWORD=
DEEPFOCUS_SMTP_FROM=
DEEPFOCUS_SMTP_TLS=1
# Web Push 通道（VAPID）。配齐后 + 安装 pywebpush 才真实推送；否则降级 skipped。
DEEPFOCUS_VAPID_PRIVATE_KEY=
DEEPFOCUS_VAPID_SUBJECT=
# 微信通道（个人微信稳态桥接 gewechat）。在同机跑 gewechat、扫码登录一个专用号，
# 把信号 postText 推到目标群/好友。缺 BRIDGE_URL 时优雅降级 skipped、绝不出网。
# ⚠️ 防封：用专用小号、桥接部署在与微信号注册地同省的机器、控制频率（勿高频群发）、措辞中性。
DEEPFOCUS_WECHAT_BRIDGE_URL=          # gewechat API 基址，如 http://127.0.0.1:2531/gewe/v2/api
DEEPFOCUS_WECHAT_BRIDGE_TOKEN=        # gewechat 登录后拿到的 X-GEWE-TOKEN
DEEPFOCUS_WECHAT_BRIDGE_APPID=        # gewechat 设备 appId（扫码登录返回）
DEEPFOCUS_WECHAT_DEFAULT_TARGET=      # 默认推送目标（信号群 id，形如 xxxxxxxx@chatroom）；订阅 address 为空时兜底
# 点击回流追踪用的基址：PUBLIC=后端公开地址（拼可追踪点击链接），APP=点击后跳回的前端地址。
DEEPFOCUS_PUBLIC_BASE_URL=http://localhost:8300
DEEPFOCUS_APP_BASE_URL=http://localhost:3000

# OpenAI or OpenAI-compatible cloud model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# MiniMax uses an OpenAI-compatible endpoint.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Frontend dev server origin. Use * for local prototypes only.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional free market-data keys. Finnhub is tried first for quotes, then Alpha Vantage.
# Earnings calendar tries Nasdaq's public no-key calendar first, then Alpha Vantage
# when configured.
# Without keys quotes fall back to a no-key public snapshot source when reachable,
# while the earnings calendar returns watchlist templates only for symbols not found
# in the public calendar window.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
NASDAQ_EARNINGS_SCAN_DAYS=60
EARNINGS_CACHE_TTL_SECONDS=1800

# Optional A-share structured-data provider.
# Enables Tushare Pro daily bars, valuation, turnover, and stock metadata.
TUSHARE_TOKEN=
# Alternative env names also supported:
# TUSHARE_PRO_TOKEN=
# TS_TOKEN=

# Optional options-chain providers with IV/Greeks.
# MARKETDATA_APP_TOKEN enables MarketData.app option chains with IV/Delta/Gamma.
# TRADIER_ACCESS_TOKEN enables Tradier option chains with greeks=true.
MARKETDATA_APP_TOKEN=
TRADIER_ACCESS_TOKEN=

# Optional: Xueqiu authenticated requests for keyword crawl.
# Compatible with pysnowball/snowball-mcp style tokens.
# Use a single-line Cookie value from your own authorized Xueqiu session.
# Do not use token pools or automated CAPTCHA/WAF solving.
DEEPFOCUS_XUEQIU_COOKIE=
# Optional: paste the User-Agent from the same logged-in browser session.
DEEPFOCUS_XUEQIU_USER_AGENT=
# Optional: paste the Referer from the copied browser request.
DEEPFOCUS_XUEQIU_REFERER=
# Optional: copied /query/v1/search/status.json URL with the temporary md5 parameter.
DEEPFOCUS_XUEQIU_STATUS_URL=
# Alternative env name also supported:
# XUEQIU_TOKEN=xq_a_token=xxxxx;u=xxxx
