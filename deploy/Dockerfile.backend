# ── Backend: FastAPI (deepfocus_api) on uvicorn ──────────────────────────────
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# Cloud API requirements only (lightweight — no heavy ML).
COPY backend/requirements-cloud.txt /app/requirements-cloud.txt
RUN pip install --no-cache-dir -r requirements-cloud.txt

# App code (deepfocus_api + finogrid). Dev SQLite/.venv/.env excluded via .dockerignore.
COPY backend/ /app/

# Run from /data so the runtime SQLite files (cwd-relative) live on a volume.
RUN mkdir -p /data
WORKDIR /data

EXPOSE 8300
CMD ["uvicorn", "deepfocus_api.main:app", "--host", "0.0.0.0", "--port", "8300"]
