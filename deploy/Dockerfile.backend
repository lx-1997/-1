# ── Backend: FastAPI (deepfocus_api) on uvicorn ──────────────────────────────
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/backend \
    DEEPFOCUS_DATA_DIR=/data

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# Cloud API requirements only (lightweight — no heavy ML).
COPY backend/requirements-cloud.txt /app/requirements-cloud.txt
RUN pip install --no-cache-dir -r requirements-cloud.txt

# App code (deepfocus_api + finogrid). Dev SQLite/.venv/.env excluded via .dockerignore.
COPY backend/ /app/backend/
COPY public/logo512.png /app/public/logo512.png
COPY public/logo192.png /app/public/logo192.png

# All runtime stores resolve DEEPFOCUS_DATA_DIR; keep code and data separate.
RUN mkdir -p /data
WORKDIR /data

EXPOSE 8300
CMD ["uvicorn", "deepfocus_api.main:app", "--host", "0.0.0.0", "--port", "8300"]
