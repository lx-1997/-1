# Caddy auto-provisions HTTPS for a real DOMAIN (Let's Encrypt).
# For local testing set DOMAIN=localhost (Caddy issues a local cert).
{$DOMAIN:localhost} {
	encode zstd gzip

	# API + health + research-workbench → backend
	@backend path /api/* /mcp /health /research-workbench /research-workbench/* /.well-known/* /s/* /robots.txt /llms.txt /BingSiteAuth.xml /indexnow-key.txt /sitemap.xml /feed.xml /feed /feed/* /tutorial /developers /developers/* /review /review/* /stocks /stocks/* /stock/* /articles /article/* /about /partners /notes /note/* /reports /report/* /research /research/* /lhb /lhb/* /track-record /qa /qa/* /og/* /learn /learn/* /compare/*
	handle @backend {
		reverse_proxy backend:8300
	}

	# Everything else → frontend SPA
	handle {
		reverse_proxy frontend:80
	}
}
