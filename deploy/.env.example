# ── 复制成 .env 后按需修改 ───────────────────────────────────────────────────

# 你的域名(DNS A 记录指向本服务器)。Caddy 会自动签发 HTTPS 证书。
# 本地测试可填 localhost。
DOMAIN=terminal.example.com

# 前端构建时写入的 API 地址。单域名部署 = https://你的域名(Caddy 把 /api 转给后端)。
PUBLIC_URL=https://terminal.example.com

# ── 后端配置(pydantic-settings 读环境变量)──────────────────────────────────
DEEPFOCUS_LLM_PROVIDER=mock
DEEPFOCUS_AUTH_REQUIRED=false
DEEPFOCUS_ALLOW_SELF_REGISTER=true
DEEPFOCUS_JWT_SECRET=请改成一段足够长的随机字符串
DEEPFOCUS_PUBLIC_BASE_URL=https://terminal.example.com
DEEPFOCUS_APP_BASE_URL=https://terminal.example.com

# 跨域:单域名(Caddy 同源)无需改;若前后端分域名,填你的前端地址收紧
# CORS_ORIGINS=https://terminal.example.com

# ── 可选:接真实大模型(默认 mock,不接也能用行情/新闻)────────────────────
# DEEPFOCUS_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# 或 MiniMax:
# DEEPFOCUS_LLM_PROVIDER=minimax
# MINIMAX_API_KEY=...

# ── 可选:数据源 key(免费公开源无需任何 key)──────────────────────────────
# TUSHARE_TOKEN=
# FINNHUB_API_KEY=
# ALPHAVANTAGE_API_KEY=
